---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFab from '../../components/WhatsAppFab.astro';
import { events } from '../../data/events';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const canonicalPath = '/events/';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Teleprompter Rental by Event Type — ${site.name}`,
  itemListElement: events.map((ev, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: ev.name,
    url: new URL(`/events/${ev.slug}/`, site.url).href,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Events', item: new URL(canonicalPath, site.url).href },
  ],
};

const jsonLd = { '@graph': [itemListLd, breadcrumbLd] };
---

<BaseLayout
  title="Teleprompter Rental by Event Type | TelePrompter.my"
  description="Rent the right teleprompter for your event — corporate conferences, product launches, gala dinners, broadcast production and government events. Recommended setups, included equipment and local FAQ."
  image="assets/teleprompter-hero.webp"
  canonicalPath={canonicalPath}
  type="website"
  jsonLd={jsonLd}
>
  <Header />

  <nav class="ev-crumbs cwrap" aria-label="Breadcrumb" data-od-id="ev-index-breadcrumb">
    <a href={base}>Home</a><span>/</span><span class="cur">Events</span>
  </nav>

  <section class="ev-index-hero" data-od-id="ev-index-hero">
    <div class="bg"><img src={`${base}assets/teleprompter-hero.webp`} alt="Professional teleprompter setups for different event types." width="1920" height="1080" loading="eager"></div>
    <div class="cwrap hero-inner">
      <h1 class="reveal">Teleprompter Rental by Event Type</h1>
      <p class="hero-sub reveal">Different events demand different teleprompter setups. Choose your event type below to see which teleprompters we recommend, what is included and answers to common questions — all delivered, set up and operated by our crew.</p>
      <div class="cta-row reveal">
        <a href="#book" class="btn btn-primary" data-od-id="ev-index-cta-book">Request a Quote</a>
        <a href={`${base}#our-teleprompters`} class="btn btn-light" data-od-id="ev-index-cta-range">View All Teleprompters</a>
      </div>
    </div>
  </section>

  <section class="space" data-od-id="ev-index-grid">
    <div class="cwrap">
      <div class="title-area text-center reveal">
        <span class="eyebrow">Event types</span>
        <h2 class="sec-title">Find the right setup for your event</h2>
        <p class="sec-sub">Select an event type to see recommended teleprompters, typical scenarios and FAQ.</p>
      </div>
      <div class="ev-cards">
        {events.map((ev) => (
          <a href={`${base}events/${ev.slug}/`} class="ev-card reveal" data-od-id={`ev-card-${ev.slug}`}>
            <div class="ec-media"><img src={`${base}assets/teleprompter-hero.webp`} alt={`Teleprompter rental for ${ev.name.toLowerCase()}.`} width="640" height="400" loading="lazy"></div>
            <div class="ec-body">
              <h3>{ev.name}</h3>
              <p>{ev.shortDesc}</p>
              <span class="ec-link">View event type <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
  <WhatsAppFab />
</BaseLayout>

<style is:global>
  .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .sec-sub { color: var(--muted); margin-top: 18px; max-width: 50ch; margin-left: auto; margin-right: auto; }

  .ev-crumbs { display: flex; gap: 10px; align-items: center; padding-top: 28px; font-size: .78rem; color: var(--muted); }
  .ev-crumbs a:hover { color: var(--accent); }
  .ev-crumbs .cur { color: var(--fg); font-weight: 600; }

  .ev-index-hero { position: relative; min-height: 72vh; display: flex; align-items: flex-end; overflow: hidden; background: var(--dark); padding-top: 120px; }
  .ev-index-hero .bg { position: absolute; inset: 0; z-index: 0; }
  .ev-index-hero .bg img { width: 100%; height: 100%; object-fit: cover; }
  .ev-index-hero .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, rgba(8,10,30,.94) 0%, rgba(8,10,30,.72) 42%, rgba(8,10,30,.25) 72%, rgba(8,10,30,.5) 100%); }
  .ev-index-hero .hero-inner { position: relative; z-index: 2; padding-bottom: clamp(60px, 8vh, 100px); max-width: 860px; }
  .ev-index-hero h1 { color: #fff; font-size: clamp(2.2rem, 5.2vw, 4.2rem); line-height: 1.04; }
  .ev-index-hero .hero-sub { color: rgba(255,255,255,.78); font-size: 1.05rem; max-width: 66ch; margin-top: 22px; line-height: 1.7; }
  .ev-index-hero .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }

  .ev-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .ev-card { display: flex; flex-direction: column; background: var(--smoke); border: 1px solid var(--border); overflow: hidden; transition: transform .3s var(--ease), border-color .3s; }
  .ev-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .ev-card .ec-media { aspect-ratio: 16/10; overflow: hidden; }
  .ev-card .ec-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .ev-card:hover .ec-media img { transform: scale(1.05); }
  .ev-card .ec-body { padding: 26px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .ev-card h3 { font-size: 1.5rem; }
  .ev-card .ec-body p { color: var(--muted); font-size: .88rem; flex: 1; }
  .ev-card .ec-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: var(--accent); font-size: .76rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .ev-card .ec-link svg { width: 16px; height: 16px; }

  @media (max-width: 1100px) { .ev-cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 880px) { .ev-index-hero { min-height: auto; padding-top: 100px; padding-bottom: 40px; } }
  @media (max-width: 640px) { .ev-cards { grid-template-columns: 1fr; } }
</style>
