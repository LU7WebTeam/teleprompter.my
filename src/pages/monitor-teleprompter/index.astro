---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFab from '../../components/WhatsAppFab.astro';
import Terms from '../../components/Terms.astro';
import Contact from '../../components/Contact.astro';
import Gallery from '../../components/Gallery.astro';
import { getProduct } from '../../data/products';
import { site } from '../../data/site';

const product = getProduct('monitor-teleprompter')!;
---
<BaseLayout title={`${product.name} Rental for Events in Malaysia — TelePrompter.my`} description={product.longDesc}>
  <Header />

  <!-- Product Hero -->
  <section class="pd-hero" data-od-id="section-product-hero">
    <div class="cwrap">
      <h1 class="pd-title reveal">{product.name}</h1>
      <div class="pd-hero-media reveal">
        <span class="pd-tag">{product.tag}</span>
        <img src={product.img} alt={product.alt} width="640" height="360">
      </div>
      <p class="pd-lead reveal">{product.longDesc}</p>
    </div>
  </section>

  <!-- Gallery -->
  <Gallery />

  <!-- Specs + Pricing -->
  <section class="space pd-specs-section" data-od-id="section-product-specs">
    <div class="cwrap">
      <div class="pd-info-grid">
        <div class="pd-info-left reveal">
          <span style="font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);">What's Included</span>
          <h2 class="sec-title" style="margin-top:14px;">Full Equipment List</h2>
          <ul class="pd-specs">
            {product.specs.map(spec => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 5-4 9-9 9s-9-4-9-9 4-9 9-9c2 0 4 .7 5.5 2"/></svg>
                <span>{spec}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pd-info-right reveal">
          <div class="pd-actions">
            <div class="pd-price-block">
              <div class="pd-price-label">Rate</div>
              <div class="pd-price mono">
                <span class="cur">{product.currency}</span>{product.price.toLocaleString()}<span class="unit"> {product.unit}</span>
              </div>
              <div class="pd-transport">✓ {product.transport}</div>
            </div>
            <a href="#book" class="btn btn-primary" data-od-id="cta-book-detail">Book Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Terms -->
  <Terms />

  <!-- Contact / Book -->
  <Contact />

  <Footer />
  <WhatsAppFab />
</BaseLayout>

<style is:global>
  /* Product Hero */
  .pd-hero { padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 5vw, 60px); background: var(--dark); color: #fff; }
  .pd-title { font-size: clamp(2.2rem, 5vw, 4rem); margin-bottom: clamp(20px, 3vw, 36px); color: #fff; }
  .pd-hero-media { position: relative; margin-bottom: clamp(24px, 4vw, 40px); }
  .pd-hero-media img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .pd-tag {
    position: absolute; top: 16px; left: 16px; z-index: 1;
    font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #fff; background: rgba(24,43,158,.85); padding: 6px 14px; border-radius: 0;
  }
  .pd-lead { color: rgba(255,255,255,.6); font-size: 1rem; line-height: 1.7; max-width: 70ch; }

  /* Specs + Pricing */
  .pd-specs-section { background: var(--dark); color: #fff; }
  .pd-info-grid { display: grid; grid-template-columns: 65fr 35fr; gap: clamp(30px, 5vw, 60px); align-items: start; }
  .pd-specs { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 28px; }
  .pd-specs li { display: flex; gap: 12px; align-items: flex-start; font-size: .92rem; color: rgba(255,255,255,.85); padding: 14px 16px 14px 0; border-top: 1px solid rgba(255,255,255,.1); }
  .pd-specs li svg { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; margin-top: 1px; }
  .pd-actions {
    display: flex; flex-direction: column; gap: 20px;
    padding: 28px; background: #fff; border: 1px solid var(--border); border-radius: 0;
    position: sticky; top: 110px;
  }
  .pd-price-block .pd-price-label { font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pd-price-block .pd-price { font-family: var(--font-display); font-weight: 700; font-size: 2.4rem; line-height: 1; margin-top: 8px; color: var(--fg); }
  .pd-price-block .pd-price .cur { font-size: 1rem; color: var(--muted); margin-right: 2px; }
  .pd-price-block .pd-price .unit { font-size: .85rem; color: var(--muted); font-weight: 400; }
  .pd-price-block .pd-transport { font-size: .78rem; color: var(--status); margin-top: 10px; font-weight: 500; }
  .pd-actions .btn { width: 100%; }

  /* Responsive */
  @media (max-width: 880px) {
    .pd-info-grid { grid-template-columns: 1fr; }
    .pd-actions { position: static; }
    .pd-specs { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .pd-title { font-size: 1.8rem; }
    .pd-lead { font-size: .92rem; }
    .pd-specs li { font-size: .85rem; }
    .pd-actions { padding: 20px; }
    .pd-price-block .pd-price { font-size: 2rem; }
  }
</style>
