---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFab from '../../components/WhatsAppFab.astro';
import { locations } from '../../data/locations';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const canonicalPath = '/locations/';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Teleprompter Rental Locations in Malaysia — ${site.name}`,
  itemListElement: locations.map((loc, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: loc.name,
    url: new URL(`/locations/${loc.slug}/`, site.url).href,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: new URL(canonicalPath, site.url).href },
  ],
};

const jsonLd = { '@graph': [itemListLd, breadcrumbLd] };
---

<BaseLayout
  title="Teleprompter Rental Locations in Malaysia | TelePrompter.my"
  description="Rent professional teleprompters across Malaysia — Kuala Lumpur, Klang Valley, Putrajaya, Penang, Johor and more. Delivered, set up and operated by our crew."
  image="assets/teleprompter-hero.webp"
  canonicalPath={canonicalPath}
  type="website"
  jsonLd={jsonLd}
>
  <Header />

  <nav class="loc-crumbs cwrap" aria-label="Breadcrumb" data-od-id="loc-index-breadcrumb">
    <a href={base}>Home</a><span>/</span><span class="cur">Locations</span>
  </nav>

  <section class="loc-index-hero" data-od-id="loc-index-hero">
    <div class="bg"><img src={`${base}assets/teleprompter-hero.webp`} alt="Professional teleprompter setup for events across Malaysia." width="1920" height="1080" loading="eager"></div>
    <div class="cwrap hero-inner">
      <h1 class="reveal">Teleprompter Rental Across Malaysia</h1>
      <p class="hero-sub reveal">We deliver, set up and operate professional teleprompters for conferences, launches, broadcasts and productions nationwide. Choose your location below to see coverage, pricing and local FAQ.</p>
      <div class="cta-row reveal">
        <a href="#book" class="btn btn-primary" data-od-id="loc-index-cta-book">Request a Quote</a>
        <a href={`${base}#our-teleprompters`} class="btn btn-light" data-od-id="loc-index-cta-range">View Teleprompters</a>
      </div>
    </div>
  </section>

  <section class="space" data-od-id="loc-index-grid">
    <div class="cwrap">
      <div class="title-area text-center reveal">
        <span class="eyebrow">Locations</span>
        <h2 class="sec-title">Find teleprompter rental near you</h2>
        <p class="sec-sub">Select a location to see the areas we cover, what is included and local FAQ.</p>
      </div>
      <div class="loc-cards">
        {locations.map((loc) => (
          <a href={`${base}locations/${loc.slug}/`} class="loc-card reveal" data-od-id={`loc-card-${loc.slug}`}>
            <div class="lc-media"><img src={`${base}assets/teleprompter-hero.webp`} alt={`Teleprompter rental in ${loc.name}.`} width="640" height="400" loading="lazy"></div>
            <div class="lc-body">
              <span class="lc-region">{loc.region}</span>
              <h3>{loc.name}</h3>
              <p>{loc.heroBadge}</p>
              <span class="lc-link">View location <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
  <WhatsAppFab />
</BaseLayout>

<style is:global>
  .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .sec-sub { color: var(--muted); margin-top: 18px; max-width: 50ch; margin-left: auto; margin-right: auto; }

  .loc-crumbs { display: flex; gap: 10px; align-items: center; padding-top: 28px; font-size: .78rem; color: var(--muted); }
  .loc-crumbs a:hover { color: var(--accent); }
  .loc-crumbs .cur { color: var(--fg); font-weight: 600; }

  .loc-index-hero { position: relative; min-height: 72vh; display: flex; align-items: flex-end; overflow: hidden; background: var(--dark); padding-top: 120px; }
  .loc-index-hero .bg { position: absolute; inset: 0; z-index: 0; }
  .loc-index-hero .bg img { width: 100%; height: 100%; object-fit: cover; }
  .loc-index-hero .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, rgba(8,10,30,.94) 0%, rgba(8,10,30,.72) 42%, rgba(8,10,30,.25) 72%, rgba(8,10,30,.5) 100%); }
  .loc-index-hero .hero-inner { position: relative; z-index: 2; padding-bottom: clamp(60px, 8vh, 100px); max-width: 860px; }
  .loc-index-hero h1 { color: #fff; font-size: clamp(2.2rem, 5.2vw, 4.2rem); line-height: 1.04; }
  .loc-index-hero .hero-sub { color: rgba(255,255,255,.78); font-size: 1.05rem; max-width: 62ch; margin-top: 22px; line-height: 1.7; }
  .loc-index-hero .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }

  .loc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .loc-card { display: flex; flex-direction: column; background: var(--smoke); border: 1px solid var(--border); overflow: hidden; transition: transform .3s var(--ease), border-color .3s; }
  .loc-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .loc-card .lc-media { aspect-ratio: 16/10; overflow: hidden; }
  .loc-card .lc-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .loc-card:hover .lc-media img { transform: scale(1.05); }
  .loc-card .lc-body { padding: 26px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .loc-card .lc-region { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .loc-card h3 { font-size: 1.5rem; }
  .loc-card .lc-body p { color: var(--muted); font-size: .88rem; flex: 1; }
  .loc-card .lc-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: var(--accent); font-size: .76rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .loc-card .lc-link svg { width: 16px; height: 16px; }

  @media (max-width: 1100px) { .loc-cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 880px) { .loc-index-hero { min-height: auto; padding-top: 100px; padding-bottom: 40px; } }
  @media (max-width: 640px) { .loc-cards { grid-template-columns: 1fr; } }
</style>
