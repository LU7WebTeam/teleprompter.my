---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Products from '../components/Products.astro';
import Terms from '../components/Terms.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---
<BaseLayout canonicalPath="/" type="website">
