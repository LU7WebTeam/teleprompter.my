---
const logoSlots = [
  { id: 1, icon: '<path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6-6.3 4.6L7.8 14 2 9.4h7.6z"/>' },
  { id: 2, icon: '<circle cx="12" cy="12" r="9"/>' },
  { id: 3, icon: '<path d="M4 4h16v16H4z"/>' },
  { id: 4, icon: '<path d="M12 2v20M2 12h20"/>' },
  { id: 5, icon: '<path d="M3 20L12 4l9 16z"/>' },
  { id: 6, icon: '<path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/>' },
  { id: 7, icon: '<path d="M5 12h14M5 6h14M5 18h14"/>' },
  { id: 8, icon: '<path d="M2 12c4-6 16-6 20 0-4 6-16 6-20 0z"/>' },
];
---
<div class="marquee-band" data-od-id="client-logo-marquee" aria-label="Client logo marquee (placeholder)">
  <div class="m-label">Trusted by teams across Malaysia · <span style="color:var(--muted)">placeholder logos — to be replaced</span></div>
  <div class="marquee">
    <div class="marquee-track">
      {logoSlots.map(slot => (
        <div class="logo-slot" data-od-id={`client-logo-slot-${slot.id}`}>
          <span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={slot.icon}></svg></span>
          Client Logo
        </div>
      ))}
    </div>
    <div class="marquee-track" aria-hidden="true">
      {logoSlots.map(slot => (
        <div class="logo-slot">
          <span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={slot.icon}></svg></span>
          Client Logo
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-band { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 30px 0; overflow: hidden; background: var(--surface); }
  .marquee-band .m-label { text-align: center; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .25em; text-transform: uppercase; color: var(--muted); margin-bottom: 24px; }
  .marquee { display: flex; gap: 64px; width: max-content; animation: scrollx 32s linear infinite; }
  .marquee:hover { animation-play-state: paused; }
  .marquee-track { display: flex; gap: 64px; flex-shrink: 0; }
  .logo-slot {
    display: flex; align-items: center; gap: 12px; color: var(--muted); flex-shrink: 0;
    font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -.02em; opacity: .6;
    transition: opacity .2s, color .2s;
  }
  .logo-slot:hover { opacity: 1; color: var(--fg); }
  .logo-slot .mark {
    width: 38px; height: 38px; border-radius: 9px; background: var(--surface-2); border: 1px solid var(--border);
    display: grid; place-items: center; color: var(--accent-bright);
  }
  .logo-slot .mark svg { width: 20px; height: 20px; }
  @keyframes scrollx { to { transform: translateX(-50%); } }
</style>
