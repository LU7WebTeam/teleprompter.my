---
import { site } from '../data/site';
import { products } from '../data/products';
---
<footer class="site-footer" data-od-id="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="#" class="brand">
          <img src="/assets/logo.png" alt="TelePrompter.my logo" width="36" height="36">
          <span>TelePrompter<span style="color:var(--accent-bright)">.my</span></span>
        </a>
        <p>{site.footer.tagline}</p>
      </div>
      <div class="foot-col">
        <h5>Products</h5>
        {products.map(p => (
          <a href={p.detailLink}>{p.name}</a>
        ))}
      </div>
      <div class="foot-col">
        <h5>Contact</h5>
        <p>
          {site.contact.address.line1}<br>
          {site.contact.address.line2}<br>
          {site.contact.address.line3}<br>
          {site.contact.address.line4}
        </p>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={site.contact.whatsapp.href}>{site.contact.whatsapp.number}</a>
      </div>
      <div class="foot-cta">
        <h5>Have an inquiry?</h5>
        <p>Get a quote for your next event — we respond fast.</p>
        <a href="#book" class="btn btn-primary" data-od-id="cta-get-quote" style="width:100%;">Get a Quote</a>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="copy">{site.footer.copyright}</div>
      <div class="copy" style="display:flex; gap:18px;">
        <a href={site.footer.termsLink}>Terms and Services</a>
        <a href={site.footer.privacyLink}>Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: clamp(60px, 7vw, 90px) 0 36px; background: oklch(13% 0.008 264); }
  .foot-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 40px; padding-bottom: 50px; border-bottom: 1px solid var(--border); }
  .foot-brand .brand { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.03em; }
  .foot-brand .brand img { width: 36px; height: 36px; object-fit: contain; border-radius: 8px; }
  .foot-brand p { color: var(--muted); font-size: .9rem; margin-top: 18px; max-width: 36ch; }
  .foot-col h5 { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
  .foot-col a, .foot-col p { display: block; color: var(--muted); font-size: .9rem; margin-bottom: 10px; transition: color .2s; }
  .foot-col a:hover { color: var(--accent-bright); }
  .foot-cta { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
  .foot-cta h5 { color: var(--fg); font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -.02em; text-transform: none; margin-bottom: 8px; }
  .foot-cta p { color: var(--muted); font-size: .85rem; margin-bottom: 16px; }
  .foot-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 28px; flex-wrap: wrap; gap: 12px; }
  .foot-bottom .copy { font-size: .82rem; color: var(--muted); }
  .foot-bottom .copy a { color: var(--accent-bright); }

  @media (max-width: 980px) {
    .foot-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 720px) {
    .foot-top { grid-template-columns: 1fr; }
  }
</style>
