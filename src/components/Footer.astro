---
import { site } from '../data/site';
import { products } from '../data/products';
---
<footer class="site-footer" data-od-id="site-footer">
  <div class="cwrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="#" class="brand">
          <img src="/assets/logo.png" alt="TelePrompter.my logo" width="40" height="40">
          <span style="color:#fff;">TelePrompter<span class="dot" style="color:var(--accent-soft);">.my</span></span>
        </a>
        <p>{site.footer.tagline}</p>
      </div>
      <div class="foot-col">
        <h5>Products</h5>
        {products.map(p => <a href={p.detailLink}>{p.name}</a>)}
      </div>
      <div class="foot-col">
        <h5>Contact</h5>
        <p>
          {site.contact.address.line1}<br>
          {site.contact.address.line2}<br>
          {site.contact.address.line3}<br>
          {site.contact.address.line4}
        </p>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={site.contact.whatsapp.href}>{site.contact.whatsapp.number}</a>
      </div>
      <div class="foot-cta">
        <h5>Have an inquiry?</h5>
        <p>Get a quote for your next event — we respond fast.</p>
        <a href="#book" class="btn btn-primary" data-od-id="cta-get-quote" style="width:100%;">Get a Quote</a>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="copy">{site.footer.copyright}</div>
      <div class="links">
        <a href={site.footer.termsLink}>Terms and Services</a>
        <a href={site.footer.privacyLink}>Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--dark); color: rgba(255,255,255,.6); padding: clamp(70px, 8vw, 110px) 0 36px; }
  .foot-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.3fr; gap: 40px; padding-bottom: 56px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .foot-brand .brand { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: #fff; margin-bottom: 18px; }
  .foot-brand .brand img { width: 40px; height: 40px; object-fit: contain; border-radius: 8px; }
  .foot-brand p { font-size: .9rem; max-width: 40ch; line-height: 1.6; }
  .foot-col h5 { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #fff; margin-bottom: 18px; }
  .foot-col a, .foot-col p { display: block; font-size: .9rem; margin-bottom: 12px; transition: color .2s; line-height: 1.5; }
  .foot-col a:hover { color: var(--accent-soft); }
  .foot-cta { background: var(--dark-2); border-radius: 14px; padding: 26px; }
  .foot-cta h5 { color: #fff; font-size: 1.25rem; text-transform: none; letter-spacing: 0; margin-bottom: 8px; }
  .foot-cta p { font-size: .88rem; margin-bottom: 18px; }
  .foot-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 30px; flex-wrap: wrap; gap: 12px; }
  .foot-bottom .copy { font-size: .82rem; }
  .foot-bottom .copy a { color: var(--accent-soft); }
  .foot-bottom .links { display: flex; gap: 22px; }
  .foot-bottom .links a { font-size: .82rem; }
  .foot-bottom .links a:hover { color: #fff; }

  @media (max-width: 880px) { .foot-top { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 640px) { .foot-top { grid-template-columns: 1fr; } }
</style>
