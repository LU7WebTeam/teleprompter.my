---
import { site } from '../data/site';

const whatsappHref = `${site.contact.whatsapp.href}?text=${encodeURIComponent(site.contact.whatsapp.prefill)}`;
---
<header class="site-header" data-od-id="site-header">
  <div class="wrap inner">
    <a href="#" class="brand" data-od-id="brand-logo">
      <img src="/assets/logo.png" alt="TelePrompter.my logo" width="36" height="36">
      <span>TelePrompter<span style="color:var(--accent-bright)">.my</span></span>
    </a>
    <nav class="nav" data-od-id="main-nav" aria-label="Primary">
      <div class="nav-drop">
        <button aria-haspopup="true">On Camera ▾</button>
        <div class="menu">
          <div class="group-label">On Camera</div>
          {site.nav.products.onCamera.map(item => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
      <div class="nav-drop">
        <button aria-haspopup="true">On Stage ▾</button>
        <div class="menu">
          <div class="group-label">On Stage</div>
          {site.nav.products.onStage.map(item => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
      {site.nav.links.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="#book" class="btn btn-primary" data-od-id="cta-book-now">Book Now</a>
    </nav>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
  {site.nav.products.onCamera.map(item => (
    <a href={item.href}>{item.label}</a>
  ))}
  {site.nav.products.onStage.map(item => (
    <a href={item.href}>{item.label}</a>
  ))}
  {site.nav.links.map(link => (
    <a href={link.href}>{link.label}</a>
  ))}
  <a href="#book" class="btn btn-primary">Book Now</a>
</nav>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    background: oklch(15% 0.010 264 / .72);
    border-bottom: 1px solid var(--border);
  }
  .site-header .inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.03em; }
  .brand img { width: 36px; height: 36px; object-fit: contain; border-radius: 8px; }
  .nav { display: flex; align-items: center; gap: 8px; }
  .nav a, .nav .nav-drop > button {
    font-size: .92rem; color: var(--muted); padding: 8px 14px; border-radius: 8px; transition: color .2s;
    background: none; border: none; cursor: pointer; font-family: var(--font-body);
  }
  .nav a:hover, .nav .nav-drop > button:hover { color: var(--fg); }
  .nav-drop { position: relative; }
  .nav-drop .menu {
    position: absolute; top: calc(100% + 8px); left: 0; min-width: 240px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 8px;
    opacity: 0; visibility: hidden; transform: translateY(-6px); transition: all .2s var(--ease);
    box-shadow: 0 24px 50px -20px #000;
  }
  .nav-drop:hover .menu, .nav-drop:focus-within .menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .menu .group-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding: 10px 12px 6px; }
  .menu a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--fg); font-size: .9rem; }
  .menu a:hover { background: var(--surface-2); color: var(--accent-bright); }
  .nav .btn { margin-left: 10px; }
  .burger { display: none; background: none; border: 1px solid var(--border); border-radius: 10px; width: 44px; height: 44px; cursor: pointer; color: var(--fg); }
  .burger svg { width: 20px; height: 20px; }

  .mobile-nav { display: none; }

  @media (max-width: 720px) {
    .nav, .nav-drop { display: none; }
    .burger { display: grid; place-items: center; }
    .mobile-nav.open { display: flex; }
    .mobile-nav {
      position: fixed; inset: 72px 0 auto 0; flex-direction: column; gap: 4px; padding: 16px 24px 24px;
      background: var(--surface); border-bottom: 1px solid var(--border); z-index: 99;
    }
    .mobile-nav a { padding: 12px 8px; border-bottom: 1px solid var(--border); color: var(--fg); }
    .mobile-nav .btn { margin-top: 10px; }
  }
</style>
