---
import { site } from '../data/site';
---
<section class="hero" data-od-id="section-hero">
  <div class="bg"><img src="/assets/hero-2.webp" alt="Dual Presidential Teleprompter setup at a formal event." width="1920" height="1080"></div>
  <div class="cwrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Rent a Teleprompter<br><span class="blue">Anywhere</span> in<br><span class="em">Malaysia</span></h1>
        <div class="cta-row">
          <a href="#our-teleprompters" class="btn btn-primary" data-od-id="cta-view-teleprompters">View Teleprompters</a>
          <a href="#book" class="btn btn-light" data-od-id="cta-book-now-hero">Book Now</a>
        </div>
        <p class="managed">Proudly managed by <a href={site.footer.managedByHref} target="_blank" rel="noopener">{site.footer.managedBy}</a></p>
      </div>
      <div class="hero-side">
        <div class="hero-card" data-od-id="hero-info-card">
          <img src="/assets/hero-1.webp" alt="iPad teleprompter mounted on a tripod with a professional camera." width="640" height="400">
          <div class="hc-body">
            <h4 class="hc-title">Fully operated packages — setup to tear down</h4>
            <a href="#our-teleprompters" class="hc-link">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><circle cx="16" cy="16" r="14"/><path d="M13 11l8 5-8 5z" fill="currentColor"/></svg>
              Explore range
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 92vh; display: flex; align-items: flex-end; overflow: hidden; background: #111; }
  .hero .bg { position: absolute; inset: 0; z-index: 0; }
  .hero .bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, rgba(8,10,30,.92) 0%, rgba(8,10,30,.7) 38%, rgba(8,10,30,.2) 70%, rgba(8,10,30,.45) 100%); }
  .hero .cwrap { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(60px, 8vh, 100px); padding-top: 120px; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr .6fr; gap: 40px; align-items: end; }
  .hero h1 { color: #fff; font-size: clamp(2.6rem, 6.4vw, 5.2rem); line-height: 1.02; font-weight: 600; }
  .hero h1 .em { color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.6); }
  .hero h1 .blue { color: #6b8bff; }
  .hero .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 38px; }
  .hero .managed { margin-top: 30px; font-size: .82rem; color: rgba(255,255,255,.6); font-weight: 400; }
  .hero .managed a { color: #8aa4ff; border-bottom: 1px solid rgba(138,164,255,.4); }
  .hero-card { position: relative; border-radius: 16px; overflow: hidden; max-width: 360px; margin-left: auto; box-shadow: 0 30px 60px -20px rgba(0,0,0,.5); }
  .hero-card img { width: 100%; height: 220px; object-fit: cover; }
  .hero-card .hc-body { background: rgba(14,16,40,.82); backdrop-filter: blur(8px); padding: 22px 24px; }
  .hero-card .hc-title { color: #fff; font-size: 1.05rem; font-weight: 600; line-height: 1.3; }
  .hero-card .hc-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; color: #8aa4ff; font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-card { max-width: 100%; margin-left: 0; margin-top: 20px; }
  }
  @media (max-width: 640px) {
    .hero .cta-row { flex-direction: column; align-items: stretch; }
    .hero .cta-row .btn { width: 100%; }
  }
</style>
