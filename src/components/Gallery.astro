---
const galleryItems = [
  { img: "/assets/gallery-1.jpg", alt: "PMX at a podium using transparent teleprompter screens during a formal event.", cat: "Presidential", title: "Formal address with teleprompter screens", href: "/assets/gallery-1.jpg" },
  { img: "/assets/gallery-2.jpg", alt: "Close-up of a professional iPad teleprompter setup mounted on a tripod.", cat: "On Camera", title: "iPad teleprompter on tripod", href: "/assets/gallery-2.jpg" },
  { img: "/assets/gallery-3.jpg", alt: "Monitor Teleprompter system in a modern office setting.", cat: "Monitor", title: '22" Monitor teleprompter in studio', href: "/assets/gallery-3.jpg" },
  { img: "/assets/gallery-4.jpg", alt: "Large angled stage TV teleprompter displaying colorful text at an event.", cat: "Stage TV", title: "Stage TV teleprompter at an event", href: "/assets/gallery-4.jpg" },
  { img: "/assets/gallery-5.jpg", alt: "Stage TV Teleprompter screen on the floor showing countdown numbers.", cat: "Stage TV", title: "Floor prompter — countdown mode", href: "/assets/gallery-5.jpg" },
  { img: "/assets/gallery-6.jpg", alt: "Podium with dual Presidential Teleprompters set up for a speech.", cat: "Presidential", title: "Dual Presidential teleprompters", href: "/assets/gallery-6.jpg" },
  { img: "/assets/gallery-7.jpg", alt: "Speaker in green batik delivering a speech using Presidential Teleprompter screens.", cat: "Presidential", title: "Conference — live address", href: "/assets/gallery-7.jpg" },
  { img: "/assets/gallery-8.jpg", alt: "iPad teleprompter setup at a show with a panel speaker seated nearby.", cat: "On Camera", title: "Panel session with iPad prompter", href: "/assets/gallery-8.jpg" },
];
---
<section class="space" data-od-id="section-gallery" id="gallery">
  <div class="cwrap">
    <div class="title-area text-center reveal">
      <h2 class="sec-title">Real setups, real stages</h2>
    </div>
    <div class="gallery-grid">
      {galleryItems.map(item => (
        <a href={item.href} class="pf-item reveal">
          <img src={item.img} alt={item.alt} width="600" height="800">
          <div class="pf-meta">
            <span class="pf-cat">{item.cat}</span>
            <h3 class="pf-title">{item.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .pf-item { position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 3/4; background: var(--smoke); cursor: pointer; display: block; }
  .pf-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .pf-item:hover img { transform: scale(1.05); }
  .pf-item .pf-meta { position: absolute; left: 0; right: 0; bottom: 0; padding: 20px; background: linear-gradient(to top, rgba(8,10,30,.92), transparent); color: #fff; transform: translateY(10px); opacity: 0; transition: all .35s var(--ease); }
  .pf-item:hover .pf-meta { transform: translateY(0); opacity: 1; }
  .pf-item .pf-cat { font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8aa4ff; }
  .pf-item .pf-title { font-family: var(--font-display); font-size: .98rem; margin-top: 8px; line-height: 1.25; }

  @media (max-width: 1100px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .gallery-grid { grid-template-columns: 1fr; } }
</style>
