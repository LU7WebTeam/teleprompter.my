---
const base = import.meta.env.BASE_URL;

const galleryItems = [
  { img: "assets/gallery-1.jpg", alt: "PMX at a podium using transparent teleprompter screens during a formal event.", cat: "Presidential", title: "Formal address with teleprompter screens" },
  { img: "assets/gallery-2.jpg", alt: "Close-up of a professional iPad teleprompter setup mounted on a tripod.", cat: "On Camera", title: "iPad teleprompter on tripod" },
  { img: "assets/gallery-3.jpg", alt: "Monitor Teleprompter system in a modern office setting.", cat: "Monitor", title: '22" Monitor teleprompter in studio' },
  { img: "assets/gallery-4.jpg", alt: "Large angled stage TV teleprompter displaying colorful text at an event.", cat: "Stage TV", title: "Stage TV teleprompter at an event" },
  { img: "assets/gallery-5.jpg", alt: "Stage TV Teleprompter screen on the floor showing countdown numbers.", cat: "Stage TV", title: "Floor prompter — countdown mode" },
  { img: "assets/gallery-6.jpg", alt: "Podium with dual Presidential Teleprompters set up for a speech.", cat: "Presidential", title: "Dual Presidential teleprompters" },
  { img: "assets/gallery-7.jpg", alt: "Speaker in green batik delivering a speech using Presidential Teleprompter screens.", cat: "Presidential", title: "Conference — live address" },
  { img: "assets/gallery-8.jpg", alt: "iPad teleprompter setup at a show with a panel speaker seated nearby.", cat: "On Camera", title: "Panel session with iPad prompter" },
];

// Clone items for infinite loop feel (enough items for smooth scrolling)
const allItems = [...galleryItems, ...galleryItems, ...galleryItems];
---
<section class="space" data-od-id="section-gallery" id="gallery">
  <div class="cwrap">
    <div class="title-area text-center reveal">
      <h2 class="sec-title">Gallery</h2>
    </div>
  </div>
  <div class="gallery-carousel-wrap">
    <button class="gal-arrow gal-prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="gal-viewport" id="galViewport">
      <div class="gal-track" id="galTrack">
        {allItems.map((item, i) => (
          <button type="button" class="pf-item" data-index={i} data-title={item.title} data-cat={item.cat}>
            <img src={`${base}${item.img}`} alt={item.alt} width="600" height="800">
            <div class="pf-meta">
              <span class="pf-cat">{item.cat}</span>
              <h3 class="pf-title">{item.title}</h3>
            </div>
          </button>
        ))}
      </div>
    </div>
    <button class="gal-arrow gal-next" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<div class="lightbox" id="galLightbox" aria-modal="true" role="dialog" aria-label="Image viewer">
  <div class="lb-backdrop" data-lb-close></div>
  <button class="lb-close" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <button class="lb-arrow lb-prev" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="lb-arrow lb-next" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <figure class="lb-figure">
    <img id="lbImg" src="" alt="">
    <figcaption class="lb-caption">
      <span class="lb-count" id="lbCount"></span>
      <span class="lb-cat" id="lbCat"></span>
      <h3 class="lb-title" id="lbTitle"></h3>
    </figcaption>
  </figure>
</div>

<style is:global>
  .gallery-carousel-wrap {
    position: relative; display: flex; align-items: center; gap: 0;
  }
  .gal-viewport {
    overflow: hidden; width: 100%; scroll-behavior: smooth;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .gal-viewport::-webkit-scrollbar { display: none; }
  .gal-track {
    display: flex; gap: 22px;
    padding: 0 max(calc((100vw - 1500px) / 2 + 40px), 40px);
  }
  .pf-item {
    flex: 0 0 calc((100% - 66px) / 4); min-width: 0;
    position: relative; display: block; overflow: hidden; cursor: pointer;
    aspect-ratio: 3/4; background: var(--smoke);
    border: none; padding: 0; color: inherit; text-align: left;
    transition: transform .6s var(--ease), opacity .4s var(--ease);
    opacity: .6;
  }
  .pf-item:hover { opacity: 1; }
  .pf-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .pf-item:hover img { transform: scale(1.05); }
  .pf-item .pf-meta {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 20px;
    background: linear-gradient(to top, rgba(8,10,30,.92), transparent);
    color: #fff; transform: translateY(10px); opacity: 0; transition: all .35s var(--ease);
  }
  .pf-item:hover .pf-meta { transform: translateY(0); opacity: 1; }
  .pf-item .pf-cat { font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8aa4ff; }
  .pf-item .pf-title { font-family: var(--font-display); font-size: .98rem; margin-top: 8px; line-height: 1.25; }

  .gal-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
    width: 52px; height: 52px; background: rgba(255,255,255,.92); border: none;
    cursor: pointer; display: grid; place-items: center;
    transition: background .2s, transform .2s; box-shadow: 0 8px 24px rgba(0,0,0,.12);
    color: var(--fg);
  }
  .gal-arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .gal-arrow svg { width: 22px; height: 22px; }
  .gal-prev { left: 20px; }
  .gal-next { right: 20px; }

  @media (max-width: 1100px) {
    .pf-item { flex: 0 0 calc((100% - 44px) / 3); }
  }
  @media (max-width: 880px) {
    .pf-item { flex: 0 0 calc((100% - 44px) / 3); opacity: 1; }
  }
  @media (max-width: 640px) {
    .pf-item { flex: 0 0 80%; aspect-ratio: 4/3; opacity: 1; }
    .gal-arrow { width: 42px; height: 42px; }
    .gal-arrow svg { width: 18px; height: 18px; }
    .gal-prev { left: 10px; }
    .gal-next { right: 10px; }
  }

  .lightbox {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    visibility: hidden; opacity: 0; pointer-events: none;
    transition: opacity .35s var(--ease), visibility .35s;
  }
  .lightbox.open { visibility: visible; opacity: 1; pointer-events: auto; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(5,7,22,.94); }
  .lb-figure {
    position: relative; z-index: 2; margin: 0;
    max-width: min(92vw, 1080px); max-height: 82vh;
    display: flex; flex-direction: column; gap: 16px;
    transform: scale(.96); transition: transform .3s var(--ease);
  }
  .lightbox.open .lb-figure { transform: scale(1); }
  #lbImg {
    width: 100%; max-height: 72vh; object-fit: contain;
    border-radius: 6px; background: #000; box-shadow: 0 24px 80px rgba(0,0,0,.6);
  }
  .lb-caption { color: #fff; text-align: center; }
  .lb-caption .lb-count { font-size: .75rem; letter-spacing: .1em; color: #8aa4ff; }
  .lb-caption .lb-cat { font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8aa4ff; }
  .lb-caption .lb-title { font-family: var(--font-display); font-size: 1.05rem; margin: 6px 0 0; }
  .lb-close {
    position: absolute; top: 22px; right: 26px; z-index: 3;
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(255,255,255,.1); border: none; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    transition: background .2s, transform .2s;
  }
  .lb-close:hover { background: rgba(255,255,255,.22); transform: rotate(90deg); }
  .lb-close svg { width: 22px; height: 22px; }
  .lb-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,.1); border: none; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    transition: background .2s, transform .2s;
  }
  .lb-arrow:hover { background: rgba(255,255,255,.22); transform: translateY(-50%) scale(1.08); }
  .lb-arrow svg { width: 26px; height: 26px; }
  .lb-prev { left: 22px; }
  .lb-next { right: 22px; }
  @media (max-width: 640px) {
    .lb-arrow { width: 42px; height: 42px; }
    .lb-arrow svg { width: 22px; height: 22px; }
    .lb-prev { left: 10px; }
    .lb-next { right: 10px; }
    .lb-close { top: 14px; right: 16px; }
  }
</style>

<script>
  (function() {
    const viewport = document.getElementById('galViewport');
    const track = document.getElementById('galTrack');
    if (!viewport || !track) return;

    const prevBtn = document.querySelector('.gal-prev');
    const nextBtn = document.querySelector('.gal-next');
    const totalOrig = 8;
    const gapMatch = getComputedStyle(track).gap;
    const gap = parseInt(gapMatch) || 22;

    function getItemWidth() {
      const items = track.querySelectorAll('.pf-item');
      if (!items.length) return 300;
      return items[0].offsetWidth;
    }

    function scrollByItems(dir) {
      const itemWidth = getItemWidth();
      const scrollAmount = itemWidth + gap;
      const currentScroll = viewport.scrollLeft;
      const targetScroll = currentScroll + scrollAmount * dir;

      viewport.scrollTo({ left: targetScroll, behavior: 'smooth' });

      const halfWidth = viewport.scrollWidth / 3;
      setTimeout(() => {
        const s = viewport.scrollLeft;
        if (s < halfWidth - 100) {
          viewport.scrollTo({ left: s + halfWidth, behavior: 'instant' });
        } else if (s > halfWidth * 2 + 100) {
          viewport.scrollTo({ left: s - halfWidth, behavior: 'instant' });
        }
      }, 400);
    }

    prevBtn?.addEventListener('click', () => scrollByItems(-1));
    nextBtn?.addEventListener('click', () => scrollByItems(1));

    viewport.scrollLeft = viewport.scrollWidth / 3;

    const lightbox = document.getElementById('galLightbox');
    if (!lightbox) return;
    const lbImg = document.getElementById('lbImg');
    const lbCount = document.getElementById('lbCount');
    const lbCat = document.getElementById('lbCat');
    const lbTitle = document.getElementById('lbTitle');
    const uniqueItems = Array.from(track.querySelectorAll('.pf-item')).slice(0, totalOrig);
    let current = 0;

    function showLb(index) {
      const item = uniqueItems[((index % totalOrig) + totalOrig) % totalOrig];
      if (!item) return;
      current = ((index % totalOrig) + totalOrig) % totalOrig;
      const img = item.querySelector('img');
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      if (lbCount) lbCount.textContent = (current + 1) + ' / ' + totalOrig;
      if (lbCat) lbCat.textContent = item.dataset.cat;
      if (lbTitle) lbTitle.textContent = item.dataset.title;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeLb() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
      lbImg.src = '';
    }

    document.querySelector('.gal-track')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.pf-item');
      if (!btn) return;
      showLb(parseInt(btn.dataset.index, 10));
    });

    lightbox.querySelector('[data-lb-close]')?.addEventListener('click', closeLb);
    lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => {
      e.stopPropagation(); showLb(current - 1);
    });
    lightbox.querySelector('[data-lb-next]')?.addEventListener('click', (e) => {
      e.stopPropagation(); showLb(current + 1);
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target.classList.contains('lb-backdrop')) closeLb();
    });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') showLb(current - 1);
      if (e.key === 'ArrowRight') showLb(current + 1);
    });
  })();
</script>
