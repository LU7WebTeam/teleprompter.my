---
---
<section class="space" data-od-id="section-terms">
  <div class="cwrap">
    <div class="terms-layout">
      <div class="title-area reveal">
        <span style="font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);">Service terms</span>
        <h2 class="sec-title" style="margin-top:14px;">Clear terms before you book</h2>
        <p class="sec-sub">The essentials of how our rentals operate. Full terms available on request.</p>
      </div>
      <div class="terms-list">
        <div class="term-card reveal" data-od-id="term-payment">
          <span class="tn">01</span>
          <h4>Split Payment</h4>
          <div class="pay-split">
            <div class="seg"><div class="pct mono">70%</div><div class="lab">Booking fee — <span class="hl">12 hours</span> before event</div></div>
            <div class="seg"><div class="pct mono">30%</div><div class="lab">Before event start</div></div>
          </div>
        </div>
        <div class="term-card reveal" data-od-id="term-surcharge">
          <span class="tn">02</span>
          <h4>Weekend & Holiday</h4>
          <p>A <span class="hl">+20%</span> surcharge applies for jobs scheduled on weekends or public holidays.</p>
        </div>
        <div class="term-card reveal" data-od-id="term-rehearsal">
          <span class="tn">03</span>
          <h4>Rehearsal</h4>
          <p>Day-before rehearsals carry an additional <span class="hl">+50%</span> charge of the selected package.</p>
        </div>
        <div class="term-card reveal" data-od-id="term-other">
          <span class="tn">04</span>
          <h4>Other essentials</h4>
          <ul>
            <li>Outside Klang Valley: transport by mileage; accommodation added if required</li>
            <li>No refunds issued for cancellations</li>
            <li>Damages result in additional costs, borne by the client</li>
            <li>All teleprompters subject to availability — book ahead</li>
            <li>Service may be withheld if payment not received in full</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .terms-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 60px; align-items: start; }
  .terms-layout .title-area { position: sticky; top: 110px; }
  .terms-list { display: grid; gap: 20px; }
  .term-card { background: var(--smoke); border-radius: var(--radius); padding: 30px 26px; border: 1px solid var(--border); }
  .term-card .tn { font-family: var(--font-display); font-size: .85rem; font-weight: 600; color: var(--accent); }
  .term-card h4 { font-size: 1.15rem; margin: 12px 0 14px; }
  .term-card p, .term-card li { color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .term-card ul { list-style: none; display: grid; gap: 8px; }
  .term-card ul li { padding-left: 16px; position: relative; }
  .term-card ul li::before { content: "—"; position: absolute; left: 0; color: var(--accent); }
  .hl { color: var(--accent); font-weight: 700; font-family: var(--font-body); }
  .pay-split { display: flex; gap: 20px; margin-top: 14px; }
  .pay-split .seg { flex: 1; }
  .pay-split .seg .pct { font-family: var(--font-display); font-size: 1.7rem; font-weight: 700; color: var(--accent); }
  .pay-split .seg .lab { font-size: .78rem; color: var(--muted); line-height: 1.4; }

  @media (max-width: 1100px) {
    .terms-layout { grid-template-columns: 1fr; }
    .terms-layout .title-area { position: static; }
  }
</style>
