---
import { features } from '../data/features';

const icons: Record<string, string> = {
  location: '<path d="M12 21s7-5.7 7-11a7 7 0 10-14 0c0 5.3 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  monitor: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  sliders: '<path d="M4 6h16M4 12h10M4 18h7"/><circle cx="19" cy="14" r="2"/>',
  currency: '<path d="M12 1v22M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 010 7H6"/>',
  'check-circle': '<path d="M9 12l2 2 4-4"/><path d="M21 12c0 5-4 9-9 9s-9-4-9-9 4-9 9-9c2 0 4 .7 5.5 2"/>',
};
---
<section class="space" data-od-id="section-why-choose">
  <div class="cwrap">
    <div class="services-layout">
      <div class="title-area reveal">
        <span style="font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);">Why choose us</span>
        <h2 class="sec-title">Built for flawless delivery, end to end</h2>
        <p class="sec-sub">From nationwide coverage to expert operators on site — every rental is handled start to finish.</p>
        <a href="#book" class="btn btn-dark" style="margin-top:30px;" data-od-id="cta-why-book">Book now</a>
      </div>
      <div class="service-list">
        {features.map(f => (
          <div class="service-item reveal" data-od-id={`feature-card-${f.icon}`}>
            <span class="s-num">{f.num}</span>
            <div class="s-body"><h4>{f.title}</h4><p>{f.desc}</p></div>
            <div class="s-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons[f.icon]}></svg></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .services-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 60px; align-items: start; }
  .services-layout .title-area { position: sticky; top: 110px; }
  .services-layout .sec-title { margin-top: 16px; }
  .services-layout .sec-sub { color: var(--muted); margin-top: 18px; max-width: 38ch; }
  .service-list { display: grid; gap: 0; }
  .service-item { display: grid; grid-template-columns: auto 1fr auto; gap: 26px; align-items: start; padding: 32px 0; border-top: 1px solid var(--border); }
  .service-item:last-child { border-bottom: 1px solid var(--border); }
  .service-item .s-num { font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--accent); padding-top: 4px; }
  .service-item .s-body h4 { font-size: 1.35rem; margin-bottom: 8px; }
  .service-item .s-body p { color: var(--muted); font-size: .95rem; }
  .service-item .s-icon { width: 56px; height: 56px; border-radius: 14px; background: oklch(60% 0.08 264 / .12); color: var(--accent); display: grid; place-items: center; }
  .service-item .s-icon svg { width: 26px; height: 26px; }

  @media (max-width: 1100px) {
    .services-layout { grid-template-columns: 1fr; }
    .services-layout .title-area { position: static; }
  }
</style>
