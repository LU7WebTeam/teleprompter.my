---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL;

const items = product.gallery;
// Clone items for infinite loop feel (enough items for smooth scrolling)
const allItems = [...items, ...items, ...items];
const totalOrig = items.length;
---
<section class="space" data-od-id="section-product-gallery" data-total={totalOrig}>
  <div class="cwrap">
    <div class="title-area text-center reveal">
      <h2 class="sec-title">Our Past Events</h2>
    </div>
  </div>
  <div class="gallery-carousel-wrap">
    <button class="pg-arrow pg-prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="pg-viewport">
      <div class="pg-track">
        {allItems.map((item, i) => (
          <button type="button" class="pg-item" data-index={i} data-caption={item.caption} data-cat={product.tag}>
            <img src={`${base}${item.img}`} alt={item.alt} width="600" height="800" loading="lazy">
            <div class="pg-meta">
              <span class="pg-cat">{product.tag}</span>
              <h3 class="pg-title">{item.caption}</h3>
            </div>
          </button>
        ))}
      </div>
    </div>
    <button class="pg-arrow pg-next" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<div class="pg-lightbox" aria-modal="true" role="dialog" aria-label="Image viewer">
  <div class="pglb-backdrop" data-lb-close></div>
  <button class="pglb-close" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <button class="pglb-arrow pglb-prev" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="pglb-arrow pglb-next" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <figure class="pglb-figure">
    <img class="pglb-img" src="" alt="">
    <figcaption class="pglb-caption">
      <span class="pglb-count"></span>
      <span class="pglb-cat"></span>
      <h3 class="pglb-title"></h3>
    </figcaption>
  </figure>
</div>

<style is:global>
  .gallery-carousel-wrap {
    position: relative; display: flex; align-items: center; gap: 0;
  }
  .pg-viewport {
    overflow: hidden; width: 100%; scroll-behavior: smooth;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .pg-viewport::-webkit-scrollbar { display: none; }
  .pg-track {
    display: flex; gap: 22px;
    padding: 0 max(calc((100vw - 1500px) / 2 + 40px), 40px);
  }
  .pg-item {
    flex: 0 0 calc((100% - 66px) / 4); min-width: 0;
    position: relative; display: block; overflow: hidden; cursor: pointer;
    aspect-ratio: 4/3; background: var(--smoke);
    border: none; padding: 0; color: inherit; text-align: left;
    transition: transform .6s var(--ease), opacity .4s var(--ease);
    opacity: .6;
  }
  .pg-item:hover { opacity: 1; }
  .pg-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .pg-item:hover img { transform: scale(1.05); }
  .pg-item .pg-meta {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 20px;
    background: linear-gradient(to top, rgba(8,10,30,.92), transparent);
    color: #fff; transform: translateY(10px); opacity: 0; transition: all .35s var(--ease);
  }
  .pg-item:hover .pg-meta { transform: translateY(0); opacity: 1; }
  .pg-item .pg-cat { font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8aa4ff; }
  .pg-item .pg-title { font-family: var(--font-display); font-size: .98rem; margin-top: 8px; line-height: 1.25; }

  .pg-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
    width: 52px; height: 52px; background: rgba(255,255,255,.92); border: none;
    cursor: pointer; display: grid; place-items: center;
    transition: background .2s, transform .2s; box-shadow: 0 8px 24px rgba(0,0,0,.12);
    color: var(--fg);
  }
  .pg-arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .pg-arrow svg { width: 22px; height: 22px; }
  .pg-prev { left: 20px; }
  .pg-next { right: 20px; }

  @media (max-width: 1100px) {
    .pg-item { flex: 0 0 calc((100% - 44px) / 3); }
  }
  @media (max-width: 880px) {
    .pg-item { flex: 0 0 calc((100% - 44px) / 3); opacity: 1; }
  }
  @media (max-width: 640px) {
    .pg-item { flex: 0 0 80%; aspect-ratio: 4/3; opacity: 1; }
    .pg-arrow { width: 42px; height: 42px; }
    .pg-arrow svg { width: 18px; height: 18px; }
    .pg-prev { left: 10px; }
    .pg-next { right: 10px; }
  }

  .pg-lightbox {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    visibility: hidden; opacity: 0; pointer-events: none;
    transition: opacity .35s var(--ease), visibility .35s;
  }
  .pg-lightbox.open { visibility: visible; opacity: 1; pointer-events: auto; }
  .pglb-backdrop { position: absolute; inset: 0; background: rgba(5,7,22,.94); }
  .pglb-figure {
    position: relative; z-index: 2; margin: 0;
    max-width: min(92vw, 1080px); max-height: 82vh;
    display: flex; flex-direction: column; gap: 16px;
    transform: scale(.96); transition: transform .3s var(--ease);
  }
  .pg-lightbox.open .pglb-figure { transform: scale(1); }
  .pglb-img {
    width: 100%; max-height: 72vh; object-fit: contain;
    border-radius: 6px; background: #000; box-shadow: 0 24px 80px rgba(0,0,0,.6);
  }
  .pglb-caption { color: #fff; text-align: center; }
  .pglb-count { font-size: .75rem; letter-spacing: .1em; color: #8aa4ff; }
  .pglb-cat { font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8aa4ff; }
  .pglb-title { font-family: var(--font-display); font-size: 1.05rem; margin: 6px 0 0; }
  .pglb-close {
    position: absolute; top: 22px; right: 26px; z-index: 3;
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(255,255,255,.1); border: none; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    transition: background .2s, transform .2s;
  }
  .pglb-close:hover { background: rgba(255,255,255,.22); transform: rotate(90deg); }
  .pglb-close svg { width: 22px; height: 22px; }
  .pglb-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,.1); border: none; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    transition: background .2s, transform .2s;
  }
  .pglb-arrow:hover { background: rgba(255,255,255,.22); transform: translateY(-50%) scale(1.08); }
  .pglb-arrow svg { width: 26px; height: 26px; }
  .pglb-prev { left: 22px; }
  .pglb-next { right: 22px; }
  @media (max-width: 640px) {
    .pglb-arrow { width: 42px; height: 42px; }
    .pglb-arrow svg { width: 22px; height: 22px; }
    .pglb-prev { left: 10px; }
    .pglb-next { right: 10px; }
    .pglb-close { top: 14px; right: 16px; }
  }
</style>

<script>
  (function() {
    const section = document.querySelector('[data-od-id="section-product-gallery"]');
    if (!section) return;

    const viewport = section.querySelector('.pg-viewport');
    const track = section.querySelector('.pg-track');
    if (!viewport || !track) return;

    const prevBtn = section.querySelector('.pg-prev');
    const nextBtn = section.querySelector('.pg-next');
    const totalOrig = parseInt(section.dataset.total, 10) || 1;
    const gapMatch = getComputedStyle(track).gap;
    const gap = parseInt(gapMatch) || 22;

    function getItemWidth() {
      const items = track.querySelectorAll('.pg-item');
      if (!items.length) return 300;
      return items[0].offsetWidth;
    }

    function scrollByItems(dir) {
      const itemWidth = getItemWidth();
      const scrollAmount = itemWidth + gap;
      const currentScroll = viewport.scrollLeft;
      const targetScroll = currentScroll + scrollAmount * dir;
      viewport.scrollTo({ left: targetScroll, behavior: 'smooth' });

      const halfWidth = viewport.scrollWidth / 3;
      setTimeout(() => {
        const s = viewport.scrollLeft;
        if (s < halfWidth - 100) {
          viewport.scrollTo({ left: s + halfWidth, behavior: 'instant' });
        } else if (s > halfWidth * 2 + 100) {
          viewport.scrollTo({ left: s - halfWidth, behavior: 'instant' });
        }
      }, 400);
    }

    prevBtn?.addEventListener('click', () => scrollByItems(-1));
    nextBtn?.addEventListener('click', () => scrollByItems(1));

    viewport.scrollLeft = viewport.scrollWidth / 3;

    const lightbox = section.nextElementSibling;
    if (!lightbox || !lightbox.classList.contains('pg-lightbox')) return;
    const lbImg = lightbox.querySelector('.pglb-img');
    const lbCount = lightbox.querySelector('.pglb-count');
    const lbCat = lightbox.querySelector('.pglb-cat');
    const lbTitle = lightbox.querySelector('.pglb-title');
    const uniqueItems = Array.from(track.querySelectorAll('.pg-item')).slice(0, totalOrig);
    let current = 0;

    function mod(n) { return ((n % totalOrig) + totalOrig) % totalOrig; }

    function showLb(index) {
      const item = uniqueItems[mod(index)];
      if (!item) return;
      current = mod(index);
      const img = item.querySelector('img');
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      if (lbCount) lbCount.textContent = (current + 1) + ' / ' + totalOrig;
      if (lbCat) lbCat.textContent = item.dataset.cat;
      if (lbTitle) lbTitle.textContent = item.dataset.caption;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeLb() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
      lbImg.src = '';
    }

    track.addEventListener('click', (e) => {
      const btn = e.target.closest('.pg-item');
      if (!btn) return;
      showLb(parseInt(btn.dataset.index, 10));
    });

    lightbox.querySelector('[data-lb-close]')?.addEventListener('click', closeLb);
    lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => {
      e.stopPropagation(); showLb(current - 1);
    });
    lightbox.querySelector('[data-lb-next]')?.addEventListener('click', (e) => {
      e.stopPropagation(); showLb(current + 1);
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target.classList.contains('pglb-backdrop')) closeLb();
    });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') showLb(current - 1);
      if (e.key === 'ArrowRight') showLb(current + 1);
    });
  })();
</script>
