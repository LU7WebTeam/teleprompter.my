---
import { products } from '../data/products';
---
<section class="space products-section" data-od-id="section-products" id="our-teleprompters">
  <div class="cwrap">
    <div class="title-area text-center reveal">
      <span style="font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);">Our teleprompters</span>
      <h2 class="sec-title" style="margin-top:14px;">Four setups for every stage and screen</h2>
    </div>
    <div class="products-grid">
      {products.map((product, i) => {
        const ids = ['presidential', 'stage-tv', 'monitor', 'ipad'];
        const id = ids[i];
        return (
          <article class="product-card reveal" data-od-id={`product-card-${id}`}>
            <img src={product.img} alt={product.alt} class="p-bg" width="640" height="800">
            <div class="p-overlay"></div>
            <div class="p-tag">{product.tag}</div>
            <div class="p-content">
              <h3>{product.name}</h3>
              <p class="p-desc">{product.desc}</p>
              <div class="p-footer">
                <div class="p-rate">
                  <div class="p-label">Rate</div>
                  <div class="p-price mono">
                    <span class="cur">{product.currency}</span>{product.price.toLocaleString()}<span class="unit"> {product.unit}</span>
                  </div>
                  <div class="transport">✓ {product.transport}</div>
                </div>
                <div class="p-btns">
                  <a href="#book" class="btn btn-primary" data-od-id={`cta-book-${id}`}>Book Now</a>
                  <a href={product.detailLink} class="btn btn-ghost" data-od-id={`read-${id}`}>Read More</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
  .products-section { background: var(--smoke); }
  .products-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .product-card {
    position: relative; border-radius: 0; overflow: hidden; display: flex; flex-direction: column;
    min-height: 560px; isolation: isolate; transition: transform .3s var(--ease);
  }
  .product-card:hover { transform: translateY(-4px); }
  .product-card .p-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    transition: transform .6s var(--ease);
  }
  .product-card:hover .p-bg { transform: scale(1.05); }
  .product-card .p-overlay {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgba(8,10,30,.96) 0%, rgba(8,10,30,.75) 45%, rgba(8,10,30,.15) 75%, rgba(8,10,30,.3) 100%);
  }
  .product-card .p-tag {
    position: absolute; top: 20px; left: 20px; z-index: 1;
    display: inline-block; width: fit-content; font-size: .68rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: #fff;
    background: rgba(24,43,158,.85); padding: 6px 14px; border-radius: 0;
  }
  .product-card .p-content {
    position: relative; z-index: 1; display: flex; flex-direction: column; flex: 1;
    padding: 28px; margin-top: auto; color: #fff;
  }
  .product-card h3 { font-size: 1.6rem; color: #fff; }
  .product-card .p-desc { color: rgba(255,255,255,.75); font-size: .88rem; margin: 10px 0 18px; line-height: 1.5; }
  .p-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; border-top: 1px solid rgba(255,255,255,.15); padding-top: 18px; }
  .p-rate .p-label { font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .p-rate .p-price { font-family: var(--font-display); font-weight: 700; font-size: 2.1rem; line-height: 1; margin-top: 6px; color: #fff; }
  .p-rate .p-price .cur { font-size: 1rem; color: rgba(255,255,255,.6); margin-right: 2px; }
  .p-rate .p-price .unit { font-size: .85rem; color: rgba(255,255,255,.5); font-weight: 400; }
  .p-rate .transport { font-size: .76rem; color: #6bdf9e; margin-top: 8px; font-weight: 500; }
  .p-btns { display: flex; flex-direction: column; gap: 8px; min-width: 140px; }
  .p-btns .btn { padding: 12px 18px; font-size: .76rem; }
  .p-btns .btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.3); }
  .p-btns .btn-ghost:hover { background: rgba(255,255,255,.1); color: #fff; }

  @media (max-width: 880px) {
    .products-grid { grid-template-columns: 1fr; }
    .p-footer { flex-direction: column; align-items: stretch; }
    .p-btns { flex-direction: row; min-width: 0; }
    .p-btns .btn { flex: 1; }
  }
  @media (max-width: 640px) {
    .products-grid { gap: 16px; }
    .product-card { min-height: 480px; }
    .product-card .p-content { padding: 22px; }
    .product-card h3 { font-size: 1.35rem; }
    .p-rate .p-price { font-size: 1.8rem; }
    .p-btns .btn { padding: 10px 14px; font-size: .72rem; }
  }
</style>
