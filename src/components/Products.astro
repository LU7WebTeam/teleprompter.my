---
import { products } from '../data/products';
---
<section class="space products-section" data-od-id="section-products" id="our-teleprompters">
  <div class="cwrap">
    <div class="title-area text-center reveal">
      <span style="font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);">Our teleprompters</span>
      <h2 class="sec-title" style="margin-top:14px;">Four setups for every stage and screen</h2>
    </div>
    <div class="products-grid">
      {products.map((product, i) => {
        const ids = ['presidential', 'stage-tv', 'monitor', 'ipad'];
        const id = ids[i];
        return (
          <article class="product-card reveal" data-od-id={`product-card-${id}`}>
            <div class="p-media">
              <span class="p-tag">{product.tag}</span>
              <img src={product.img} alt={product.alt} width="640" height="480">
            </div>
            <div class="p-body">
              <h3>{product.name}</h3>
              <p class="p-desc">{product.desc}</p>
              <div class="p-footer">
                <div class="p-rate">
                  <div class="p-label">Rate</div>
                  <div class="p-price mono">
                    <span class="cur">{product.currency}</span>{product.price.toLocaleString()}<span class="unit"> {product.unit}</span>
                  </div>
                  <div class="transport">✓ {product.transport}</div>
                </div>
                <div class="p-btns">
                  <a href="#book" class="btn btn-primary" data-od-id={`cta-book-${id}`}>Book Now</a>
                  <a href={product.detailLink} class="btn btn-outline" data-od-id={`read-${id}`}>Read More</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
  .products-section { background: var(--smoke); }
  .products-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .product-card { background: #fff; border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; transition: transform .3s var(--ease), box-shadow .3s var(--ease); border: 1px solid var(--border); }
  .product-card:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -25px rgba(0,0,0,.2); }
  .product-card .p-media { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .product-card .p-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .product-card:hover .p-media img { transform: scale(1.05); }
  .product-card .p-tag { position: absolute; top: 14px; left: 14px; background: rgba(255,255,255,.92); backdrop-filter: blur(6px); font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); padding: 6px 12px; border-radius: 100px; }
  .product-card .p-body { padding: 26px 24px; display: flex; flex-direction: column; flex: 1; }
  .product-card h3 { font-size: 1.22rem; }
  .product-card .p-desc { color: var(--muted); font-size: .85rem; margin: 8px 0 16px; line-height: 1.5; }
  .p-footer { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 24px; border-top: 1px solid var(--border); padding-top: 20px; margin-top: auto; }
  .p-rate .p-label { font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .p-rate .p-price { font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; line-height: 1; margin-top: 4px; color: var(--fg); }
  .p-rate .p-price .cur { font-size: .9rem; color: var(--muted); margin-right: 2px; }
  .p-rate .p-price .unit { font-size: .8rem; color: var(--muted); font-weight: 400; }
  .p-rate .transport { font-size: .78rem; color: var(--status); margin-top: 8px; font-weight: 500; }
  .p-btns { display: grid; gap: 8px; }
  .p-btns .btn { padding: 13px 18px; font-size: .76rem; width: 100%; }

  @media (max-width: 880px) { .products-grid { grid-template-columns: 1fr; } }
</style>
