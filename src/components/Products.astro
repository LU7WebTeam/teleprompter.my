---
import { products } from '../data/products';
---
<section class="section" data-od-id="section-products" id="our-teleprompters" style="background:var(--surface); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our teleprompters</span>
      <h2>Four setups for every stage and screen</h2>
      <p>Fully operated packages with free transport within Klang Valley. Same-day quotes available.</p>
    </div>
    <div class="products">
      {products.map((product, i) => {
        const ids = ['presidential', 'stage-tv', 'monitor', 'ipad'];
        const id = ids[i];
        return (
          <article class="product-card reveal" data-od-id={`product-card-${id}`}>
            <div class="p-media">
              <span class="tag">{product.tag}</span>
              <img src={product.img} alt={product.alt} width="640" height="400">
            </div>
            <div class="p-body">
              <h3>{product.name}</h3>
              <p class="p-desc">{product.desc}</p>
              <ul class="spec-list">
                {product.specs.map(spec => <li>{spec}</li>)}
              </ul>
              <div class="p-footer">
                <div class="price-block">
                  <div class="p-label">Rate</div>
                  <div class="p-price mono">
                    <span class="cur">{product.currency}</span>{product.price.toLocaleString()}<span class="unit"> {product.unit}</span>
                  </div>
                  <div class="transport">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l2-5h11l2 5M5 13h14v5H5z"/><circle cx="8" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
                    {product.transport}
                  </div>
                </div>
                <div class="p-btns">
                  <a href="#book" class="btn btn-primary" data-od-id={`cta-book-${id}`}>Book Now</a>
                  <a href={product.detailLink} class="btn btn-ghost" data-od-id={`read-${id}`}>Read More</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .products { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .product-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 18px; overflow: hidden;
    display: flex; flex-direction: column; transition: border-color .3s var(--ease), transform .3s var(--ease);
  }
  .product-card:hover { border-color: oklch(40% 0.19 264 / .5); transform: translateY(-4px); }
  .product-card .p-media { aspect-ratio: 16/10; overflow: hidden; position: relative; }
  .product-card .p-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .product-card:hover .p-media img { transform: scale(1.05); }
  .product-card .tag {
    position: absolute; top: 16px; left: 16px; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .18em;
    text-transform: uppercase; background: oklch(15% 0.010 264 / .8); backdrop-filter: blur(8px);
    border: 1px solid var(--border); padding: 6px 12px; border-radius: 100px; color: var(--accent-bright);
    z-index: 1;
  }
  .product-card .p-body { padding: 28px 26px; display: flex; flex-direction: column; flex: 1; }
  .product-card h3 { font-size: 1.5rem; }
  .product-card .p-desc { color: var(--muted); font-size: .9rem; margin: 10px 0 18px; }
  .spec-list { list-style: none; display: grid; gap: 7px; margin-bottom: 20px; }
  .spec-list li { display: flex; gap: 10px; font-size: .85rem; color: var(--muted); }
  .spec-list li::before { content: ""; flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent-bright); margin-top: 9px; }
  .p-footer { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--border); display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .price-block .p-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  .price-block .p-price { font-family: var(--font-display); font-weight: 700; font-size: 2rem; line-height: 1; margin-top: 4px; }
  .price-block .p-price .cur { color: var(--muted); font-size: 1.1rem; vertical-align: top; margin-right: 2px; }
  .price-block .p-price .unit { color: var(--muted); font-size: .9rem; font-weight: 500; }
  .transport { font-size: .8rem; color: var(--status); margin-top: 8px; display: flex; align-items: center; gap: 6px; }
  .transport svg { width: 14px; height: 14px; }
  .p-btns { display: flex; flex-direction: column; gap: 8px; min-width: 140px; }
  .p-btns .btn { padding: 11px 18px; font-size: .85rem; }

  @media (max-width: 980px) {
    .products { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .p-footer { flex-direction: column; align-items: stretch; }
    .p-btns { flex-direction: row; min-width: 0; }
    .p-btns .btn { flex: 1; }
  }
</style>
