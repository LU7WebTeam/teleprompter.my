tem et_pb_grid_item et_pb_gallery_item_0_4"><div class="et_pb_gallery_image landscape" data-per_page="8"><a href="https://teleprompter.my/wp-content/uploads/2024/10/Stage-TV-Teleprompter.jpg" title="Stage-TV-Teleprompter"><img loading="lazy" decoding="async" width="400" height="284" src="https://teleprompter.my/wp-content/uploads/2024/10/Stage-TV-Teleprompter-400x284.jpg" alt="Stage TV Teleprompter screen placed on the floor in front of a stage, showing countdown numbers." class="wp-image-1028" srcset="https://teleprompter.my/wp-content/uploads/2024/10/Stage-TV-Teleprompter.jpg 479w, https://teleprompter.my/wp-content/uploads/2024/10/Stage-TV-Teleprompter-400x284.jpg 480w" sizes="(max-width:479px) 479px, 100vw" /><span class="et_overlay" data-icon="" data-icon-tablet="" data-icon-phone=""></span></a></div></div><div class="et_pb_gallery_item et_pb_grid_item et_pb_gallery_item_0_5"><div class="et_pb_gallery_image landscape" data-per_page="8"><a href="https://teleprompter.my/wp-content/uploads/2024/10/Presidential-Teleprompter-1.jpg" title="Presidential-Teleprompter"><img loading="lazy" decoding="async" width="400" height="284" src="https://teleprompter.my/wp-content/uploads/2024/10/Presidential-Teleprompter-1-400x284.jpg" alt="Podium with dual Presidential Teleprompters set up for a speech at a formal event." class="wp-image-1026" srcset="https://teleprompter.my/wp-content/uploads/2024/10/Presidential-Teleprompter-1.jpg 479w, https://teleprompter.my/wp-content/uploads/2024/10/Presidential-Teleprompter-1-400x284.jpg 480w" sizes="(max-width:479px) 479px, 100vw" /><span class="et_overlay" data-icon="" data-icon-tablet="" data-icon-phone=""></span></a></div></div><div class="et_pb_gallery_item et_pb_grid_item et_pb_gallery_item_0_6"><div class="et_pb_gallery_image landscape" data-per_page="8"><a href="https://teleprompter.my/wp-content/uploads/2024/10/Presidential-Teleprompter.jpg" title="Presidential-Teleprompter"><img loading="lazy" decoding="async" width="400" height=